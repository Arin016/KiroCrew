        "rm -rf /.*",
        "rm -rf ~.*",
        "terraform destroy.*",
        "TRUNCATE TABLE.*",
        "wget .* \\| bash",
        ".*cat.*/\\.aws/.*",
        ".*cat.*/\\.ssh/.*",
        ".*cat.*/\\.gnupg/.*",
        ".*cat.*/\\.gpg/.*",
        ".*cat.*/\\.netrc.*",
        ".*cat.*/\\.git-credentials.*",
        ".*cat.*/\\.npmrc.*",
