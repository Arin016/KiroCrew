{
  "name": "kiroclaw",
  "description": "Autonomous personal AI agent \u2014 schedules recurring tasks, spawns parallel workers, learns from corrections, and operates independently via Slack",
  "model": "claude-opus-4.8",
  "tools": [
    "execute_bash",
    "fs_read",
    "fs_write",
    "code",
    "grep",
    "glob",
    "web_fetch",
    "web_search",
    "introspect",
    "session",
    "report",
    "@kiroclaw-cron",
    "@kiroclaw-core"
  ],
  "allowedTools": [
    "fs_read",
    "code",
    "glob",
    "grep",
    "web_fetch",
    "web_search",
    "introspect",
    "session",
    "report",
    "@kiroclaw-cron/cron_list",
    "@kiroclaw-cron/cron_pause",
    "@kiroclaw-cron/cron_resume",
    "@kiroclaw-cron/cron_trigger",
    "@kiroclaw-cron/cron_remove",
    "@kiroclaw-cron/cron_remove_all",
    "@kiroclaw-core"
  ],
  "resources": [
    "file://.kiro/steering/**/*.md"
  ],
  "toolsSettings": {
    "execute_bash": {
      "autoAllowReadonly": true,
      "deniedCommands": [
        "aws s3 cp .* s3://.*",
        "aws s3 mv .* s3://.*",
        "aws s3 sync .* s3://.*",
        ".*echo.*\\$AWS_SECRET.*",
        ".*echo.*\\$AWS_SESSION.*",
        ".*echo.*\\$AWS_ACCESS.*",
        ".*printenv.*AWS.*",
        ".*kiroclaw.*token",
        ".*env.*grep.*AWS.*",
        ".*python.*boto3.*get_credentials.*",
        ".*python.*botocore.*credentials.*",
        ".*curl.*169\\.254\\.169\\.254.*",
        ".*wget.*169\\.254\\.169\\.254.*",
        ".*curl.*\\$AWS_SECRET.*",
        ".*curl.*\\$AWS_ACCESS.*",
        ".*curl.*\\$AWS_SESSION.*",
        "aws autoscaling delete-.*",
        "aws cloudformation delete-stack.*",
        "aws cloudformation update-termination-protection.*",
        "aws dynamodb delete-table.*",
        "aws ec2 delete-.*",
        "aws ec2 terminate-instances.*",
        "aws ecr delete-.*",
        "aws ecs delete-.*",
        "aws eks delete-cluster.*",
        "aws elasticache delete-.*",
        "aws elb delete-.*",
        "aws elbv2 delete-.*",
        "aws glue delete-.*",
        "aws iam create-access-key.*",
        "aws iam delete-.*",
        "aws kinesis delete-.*",
        "aws kms schedule-key-deletion.*",
        "aws lambda delete-function.*",
        "aws logs delete-.*",
        "aws opensearch delete-.*",
        "aws rds delete-.*",
        "aws redshift delete-.*",
        "aws route53 delete-.*",
        "aws s3 rb.*",
        "aws s3 rm.*",
        "aws s3api delete-.*",
        "aws secretsmanager delete-secret.*",
        "aws sns delete-.*",
        "aws sqs delete-.*",
        "aws stepfunctions delete-.*",
        "cdk destroy.*",
        "chmod 777.*",
        "chmod.*/usr/.*",
        "chmod.*/etc/.*",
        "chmod.*/sbin/.*",
        "chmod.*/boot/.*",
        "chmod.*/lib/.*",
        "chmod.*/lib64/.*",
        "chown.*/usr/.*",
        "chown.*/etc/.*",
        "chown.*/sbin/.*",
        "chown.*/boot/.*",
        "chown.*/lib/.*",
        "chown.*/lib64/.*",
        "curl .* \\| bash",
        "curl .* \\| sh",
        "dd if=.*",
        "DROP DATABASE.*",
        "DROP TABLE.*",
        "export AWS_ACCESS.*",
        "export AWS_SECRET.*",
        ".*git\\s+(-\\S+\\s+[^-]\\S*\\s+|-\\S+\\s+)*push(\\s.*|$)",
        "git reset --hard.*",
        "kubectl delete namespace.*",
        "mkfs.*",
        "nc -e.*",
        "ncat -e.*",
        "pulumi destroy.*",
        "rm -rf /.*",
        "rm -rf ~.*",
        "terraform destroy.*",
        "TRUNCATE TABLE.*",
        "wget .* \\| bash",
        ".*cat.*/\\.aws/.*",
        ".*cat.*/\\.ssh/.*",
        ".*cat.*/\\.gnupg/.*",
        ".*cat.*/\\.gpg/.*",
        ".*cat.*/\\.netrc.*",
        ".*cat.*/\\.git-credentials.*",
        ".*cat.*/\\.npmrc.*",
        ".*cat.*/\\.pypirc.*",
        ".*cat.*/\\.docker/config\\.json.*",
        ".*cat.*/\\.kube/config.*",
        ".*cat.*/\\.kiroclaw/\\.env.*",
        ".*head.*/\\.aws/.*",
        ".*tail.*/\\.aws/.*",
        ".*less.*/\\.aws/.*",
        ".*more.*/\\.aws/.*",
        ".*strings.*/\\.aws/.*",
        ".*base64.*/\\.aws/.*",
        ".*head.*/\\.ssh/.*",
        ".*tail.*/\\.ssh/.*",
        ".*less.*/\\.ssh/.*",
        ".*more.*/\\.ssh/.*",
        ".*strings.*/\\.ssh/.*",
        ".*base64.*/\\.ssh/.*",
        ".*cp.*/\\.aws/.*",
        ".*cp.*/\\.ssh/.*",
        ".*python.*open.*/\\.aws/.*",
        ".*python.*open.*/\\.ssh/.*",
        ".*kiro.?claw restart.*",
        ".*kiro.?claw update.*",
        ".*kiro.?claw gateway restart.*",
        ".*\\b(kill|pkill|killall)\\b.*\\bkiro[-.]?claw\\b.*"
      ]
    },
    "shell": {
      "deniedCommands": [
        "aws s3 cp .* s3://.*",
        "aws s3 mv .* s3://.*",
        "aws s3 sync .* s3://.*",
        ".*echo.*\\$AWS_SECRET.*",
        ".*echo.*\\$AWS_SESSION.*",
        ".*echo.*\\$AWS_ACCESS.*",
        ".*printenv.*AWS.*",
        ".*kiroclaw.*token",
        ".*env.*grep.*AWS.*",
        ".*python.*boto3.*get_credentials.*",
        ".*python.*botocore.*credentials.*",
        ".*curl.*169\\.254\\.169\\.254.*",
        ".*wget.*169\\.254\\.169\\.254.*",
        ".*curl.*\\$AWS_SECRET.*",
        ".*curl.*\\$AWS_ACCESS.*",
        ".*curl.*\\$AWS_SESSION.*",
        "aws autoscaling delete-.*",
        "aws cloudformation delete-stack.*",
        "aws cloudformation update-termination-protection.*",
        "aws dynamodb delete-table.*",
        "aws ec2 delete-.*",
        "aws ec2 terminate-instances.*",
        "aws ecr delete-.*",
        "aws ecs delete-.*",
        "aws eks delete-cluster.*",
        "aws elasticache delete-.*",
        "aws elb delete-.*",
        "aws elbv2 delete-.*",
        "aws glue delete-.*",
        "aws iam create-access-key.*",
        "aws iam delete-.*",
        "aws kinesis delete-.*",
        "aws kms schedule-key-deletion.*",
        "aws lambda delete-function.*",
        "aws logs delete-.*",
        "aws opensearch delete-.*",
        "aws rds delete-.*",
        "aws redshift delete-.*",
        "aws route53 delete-.*",
        "aws s3 rb.*",
        "aws s3 rm.*",
        "aws s3api delete-.*",
        "aws secretsmanager delete-secret.*",
        "aws sns delete-.*",
        "aws sqs delete-.*",
        "aws stepfunctions delete-.*",
        "cdk destroy.*",
        "chmod 777.*",
        "chmod.*/usr/.*",
        "chmod.*/etc/.*",
        "chmod.*/sbin/.*",
        "chmod.*/boot/.*",
