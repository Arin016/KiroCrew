        ".*less.*/\\.aws/.*",
        ".*more.*/\\.aws/.*",
        ".*strings.*/\\.aws/.*",
        ".*base64.*/\\.aws/.*",
        ".*head.*/\\.ssh/.*",
        ".*tail.*/\\.ssh/.*",
        ".*less.*/\\.ssh/.*",
        ".*more.*/\\.ssh/.*",
        ".*strings.*/\\.ssh/.*",
        ".*base64.*/\\.ssh/.*",
        ".*cp.*/\\.aws/.*",
        ".*cp.*/\\.ssh/.*",
        ".*python.*open.*/\\.aws/.*",
        ".*python.*open.*/\\.ssh/.*",
        ".*kiro.?claw restart.*",
        ".*kiro.?claw update.*",
        ".*kiro.?claw gateway restart.*",
        ".*\\b(kill|pkill|killall)\\b.*\\bkiro[-.]?claw\\b.*"
      ]
    }
  },
  "includeMcpJson": false,
  "hooks": {
    "auto_approve_tools": [
      "kiroclaw browse *",
      "*kiroclaw browse *"
    ],
    "postToolUse": [
      {
        "matcher": "execute_bash",
        "command": "{ echo \"$(date -u +%Y-%m-%dT%H:%M:%SZ) BASH:\"; cat; echo; } >> ~/.kiroclaw/audit.log"
      }
    ]
  }
}
